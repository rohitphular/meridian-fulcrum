{
  "_comment": "What a report in report_master can be. Single source for the GAS validator (generated report-contract.gs), the ledger-database-load validator and the analytics compiler. Change only with a contract_version bump; regenerate the GAS copy with generate_gas.py.",
  "contract_version": 1,
  "sheet": "report_master",
  "columns": [
    "id",
    "report_type",
    "predefined_key",
    "report_name",
    "report_description",
    "measure",
    "period_preset",
    "period_from",
    "period_to",
    "compare_mode",
    "time_grain",
    "group_by_1",
    "group_by_2",
    "top_n",
    "include_other",
    "filter_account_ids",
    "filter_categories",
    "filter_tags",
    "filter_payees",
    "filter_currencies",
    "filter_countries",
    "filter_tx_types",
    "filter_amount_min",
    "filter_amount_max",
    "chart_kind",
    "record_status",
    "created_at",
    "updated_at",
    "sync_status",
    "sync_date",
    "sync_notes"
  ],
  "_comment_csv_columns": "report_master.csv carries the business columns and record_status only, like the other master CSVs; audit and sync columns are owned by the server (set on import, ignored if present).",
  "csv_columns": [
    "id",
    "report_type",
    "predefined_key",
    "report_name",
    "report_description",
    "measure",
    "period_preset",
    "period_from",
    "period_to",
    "compare_mode",
    "time_grain",
    "group_by_1",
    "group_by_2",
    "top_n",
    "include_other",
    "filter_account_ids",
    "filter_categories",
    "filter_tags",
    "filter_payees",
    "filter_currencies",
    "filter_countries",
    "filter_tx_types",
    "filter_amount_min",
    "filter_amount_max",
    "chart_kind",
    "record_status"
  ],
  "report_types": [
    {
      "key": "predefined",
      "label": "Pre-built"
    },
    {
      "key": "user_defined",
      "label": "My report"
    }
  ],
  "record_statuses": [
    "active",
    "inactive",
    "deleted",
    "locked"
  ],
  "predefined_record_status": "locked",
  "name": {
    "column": "report_name",
    "required": true,
    "min_length": 3,
    "max_length": 60,
    "unique": "case_insensitive_among_non_deleted"
  },
  "description": {
    "column": "report_description",
    "required": false,
    "max_length": 140
  },
  "measures": [
    {
      "key": "spend",
      "label": "Spending",
      "kind": "flow",
      "additive": true,
      "group_by": "all"
    },
    {
      "key": "income",
      "label": "Income",
      "kind": "flow",
      "additive": true,
      "group_by": "all"
    },
    {
      "key": "net",
      "label": "Net (income − spending)",
      "kind": "flow",
      "additive": true,
      "group_by": "all"
    },
    {
      "key": "count",
      "label": "Number of transactions",
      "kind": "flow",
      "additive": true,
      "group_by": "all"
    },
    {
      "key": "average",
      "label": "Average transaction",
      "kind": "flow",
      "additive": false,
      "group_by": "all"
    },
    {
      "key": "savings_rate",
      "label": "Savings rate %",
      "kind": "ratio",
      "additive": false,
      "group_by": []
    },
    {
      "key": "balance",
      "label": "Account balance",
      "kind": "stock",
      "additive": true,
      "group_by": [
        "account",
        "account_type",
        "currency"
      ]
    },
    {
      "key": "net_worth",
      "label": "Net worth",
      "kind": "stock",
      "additive": true,
      "group_by": []
    }
  ],
  "period_presets": [
    {
      "key": "last_7",
      "label": "Last 7 days",
      "max_days": 7
    },
    {
      "key": "last_30",
      "label": "Last 30 days",
      "max_days": 30
    },
    {
      "key": "last_60",
      "label": "Last 60 days",
      "max_days": 60
    },
    {
      "key": "last_90",
      "label": "Last 90 days",
      "max_days": 90
    },
    {
      "key": "this_week",
      "label": "This week",
      "max_days": 7
    },
    {
      "key": "last_week",
      "label": "Last week",
      "max_days": 7
    },
    {
      "key": "this_month",
      "label": "This month",
      "max_days": 31
    },
    {
      "key": "last_month",
      "label": "Last month",
      "max_days": 31
    },
    {
      "key": "last_3",
      "label": "Last 3 months",
      "max_days": 92
    },
    {
      "key": "last_6",
      "label": "Last 6 months",
      "max_days": 184
    },
    {
      "key": "last_12",
      "label": "Last 12 months",
      "max_days": 366
    },
    {
      "key": "this_quarter",
      "label": "This quarter",
      "max_days": 92
    },
    {
      "key": "last_quarter",
      "label": "Last quarter",
      "max_days": 92
    },
    {
      "key": "ytd",
      "label": "Year to date",
      "max_days": 366
    },
    {
      "key": "last_year",
      "label": "Last year",
      "max_days": 366
    },
    {
      "key": "all",
      "label": "All time",
      "max_days": null
    },
    {
      "key": "fixed",
      "label": "Fixed dates",
      "max_days": null
    }
  ],
  "period_rules": {
    "_comment": "Presets are inclusive of the anchor date (the UTC date of the job run). Weeks start on Monday (ISO). last_N months = N calendar months ending with the current month to date. fixed needs period_from and period_to as YYYY-MM-DD (UTC), from <= to; other presets leave both blank.",
    "date_format": "YYYY-MM-DD",
    "timezone": "UTC",
    "fixed_requires": [
      "period_from",
      "period_to"
    ],
    "_comment_max_days": "max_days is the longest a preset can span; GAS uses it to reject definitions over limits.max_points before saving. null (all, fixed) = checked from the dates, or by the job for all."
  },
  "compare_modes": [
    {
      "key": "none",
      "label": "Nothing"
    },
    {
      "key": "previous",
      "label": "Previous period"
    },
    {
      "key": "last_year",
      "label": "Same period last year"
    }
  ],
  "compare_rules": {
    "not_with_periods": [
      "all"
    ]
  },
  "time_grains": [
    {
      "key": "none",
      "label": "No time steps"
    },
    {
      "key": "day",
      "label": "Day"
    },
    {
      "key": "week",
      "label": "Week"
    },
    {
      "key": "month",
      "label": "Month"
    },
    {
      "key": "quarter",
      "label": "Quarter"
    },
    {
      "key": "year",
      "label": "Year"
    }
  ],
  "group_by": [
    {
      "key": "category",
      "label": "Category"
    },
    {
      "key": "sub_category",
      "label": "Sub-category"
    },
    {
      "key": "tag",
      "label": "Tag"
    },
    {
      "key": "payee",
      "label": "Payee"
    },
    {
      "key": "account",
      "label": "Account"
    },
    {
      "key": "account_type",
      "label": "Account type"
    },
    {
      "key": "currency",
      "label": "Currency"
    },
    {
      "key": "country",
      "label": "Country"
    },
    {
      "key": "city",
      "label": "City"
    }
  ],
  "group_by_rules": {
    "_comment": "group_by_1 must be set before group_by_2; the two must differ. top_n and include_other apply only with at least one group-by; without one, top_n is blank and include_other is false.",
    "max": 2,
    "top_n_values": [
      5,
      7,
      10,
      15,
      20
    ],
    "top_n_default": 7,
    "include_other_default": true
  },
  "filters": [
    {
      "key": "account_ids",
      "column": "filter_account_ids",
      "label": "Account",
      "value_type": "uuid_list",
      "max_values": 50
    },
    {
      "key": "categories",
      "column": "filter_categories",
      "label": "Category",
      "value_type": "category_list",
      "max_values": 50,
      "_comment": "Each value is a major category key, or major|minor for one sub-category."
    },
    {
      "key": "tags",
      "column": "filter_tags",
      "label": "Tag",
      "value_type": "text_list",
      "max_values": 50,
      "match": "case_insensitive"
    },
    {
      "key": "payees",
      "column": "filter_payees",
      "label": "Payee",
      "value_type": "text_list",
      "max_values": 50,
      "match": "case_insensitive"
    },
    {
      "key": "currencies",
      "column": "filter_currencies",
      "label": "Currency",
      "value_type": "currency_list",
      "max_values": 50,
      "_comment": "Account currency codes."
    },
    {
      "key": "countries",
      "column": "filter_countries",
      "label": "Country",
      "value_type": "text_list",
      "max_values": 50,
      "match": "case_insensitive"
    },
    {
      "key": "tx_types",
      "column": "filter_tx_types",
      "label": "Transaction type",
      "value_type": "tx_type_list",
      "max_values": 2,
      "values": [
        "money-in",
        "money-out"
      ]
    },
    {
      "key": "amount_min",
      "column": "filter_amount_min",
      "label": "Amount at least",
      "value_type": "amount",
      "_comment": "In the account's own currency, compared before any conversion. Non-negative; at most amount_max when both are set."
    },
    {
      "key": "amount_max",
      "column": "filter_amount_max",
      "label": "Amount at most",
      "value_type": "amount",
      "_comment": "In the account's own currency, compared before any conversion."
    }
  ],
  "filter_rules": {
    "list_separator": ";",
    "_comment": "List filters are ;-separated, trimmed, without duplicates. Filters on transactions (categories, tags, payees, countries, tx_types, amounts) do not apply to the stock measures balance and net_worth; account_ids and currencies apply to all measures.",
    "transaction_only": [
      "categories",
      "tags",
      "payees",
      "countries",
      "tx_types",
      "amount_min",
      "amount_max"
    ]
  },
  "chart_kinds": [
    {
      "key": "line",
      "label": "Line",
      "modes": [
        {
          "time_grain": "required",
          "group_by_min": 0,
          "group_by_max": 2
        }
      ],
      "measures": "all"
    },
    {
      "key": "bar",
      "label": "Bars",
      "modes": [
        {
          "time_grain": "required",
          "group_by_min": 0,
          "group_by_max": 1
        },
        {
          "time_grain": "forbidden",
          "group_by_min": 1,
          "group_by_max": 1
        }
      ],
      "measures": "all"
    },
    {
      "key": "stacked",
      "label": "Stacked bars",
      "modes": [
        {
          "time_grain": "required",
          "group_by_min": 1,
          "group_by_max": 2
        }
      ],
      "measures": "additive"
    },
    {
      "key": "hbar",
      "label": "Ranked bars",
      "modes": [
        {
          "time_grain": "forbidden",
          "group_by_min": 1,
          "group_by_max": 2
        }
      ],
      "measures": "all"
    },
    {
      "key": "donut",
      "label": "Donut",
      "modes": [
        {
          "time_grain": "forbidden",
          "group_by_min": 1,
          "group_by_max": 1
        }
      ],
      "measures": [
        "spend",
        "income",
        "count",
        "balance"
      ]
    },
    {
      "key": "table",
      "label": "Table only",
      "modes": [
        {
          "time_grain": "any",
          "group_by_min": 0,
          "group_by_max": 2
        }
      ],
      "measures": "all"
    },
    {
      "key": "number",
      "label": "Single number",
      "modes": [
        {
          "time_grain": "forbidden",
          "group_by_min": 0,
          "group_by_max": 0
        }
      ],
      "measures": "all",
      "home_slot": "tile"
    }
  ],
  "chart_rules": {
    "_comment": "A definition is valid when its measure is allowed for the chart kind and one of the kind's modes matches its time_grain (required = not none, forbidden = none) and group-by count. chart_kind number makes the report a single value, the only kind a Home tile accepts; every other kind fits a Home panel."
  },
  "limits": {
    "max_points": 400,
    "max_series": 21,
    "max_table_rows": 100,
    "fixed_period_max_days": 3660
  },
  "home": {
    "tiles": 4,
    "panels": 4,
    "tile_kinds": [
      "number"
    ],
    "panel_kinds": [
      "line",
      "bar",
      "stacked",
      "hbar",
      "donut",
      "table"
    ]
  },
  "error_codes": [
    "missing_report_name",
    "report_name_too_short",
    "report_name_too_long",
    "duplicate_report_name",
    "report_description_too_long",
    "invalid_report_type",
    "invalid_predefined_key",
    "predefined_report_locked",
    "invalid_measure",
    "invalid_period_preset",
    "invalid_period_dates",
    "period_dates_not_allowed",
    "fixed_period_too_long",
    "invalid_compare_mode",
    "compare_not_allowed",
    "invalid_time_grain",
    "invalid_group_by",
    "duplicate_group_by",
    "group_by_order",
    "group_by_not_allowed_for_measure",
    "invalid_top_n",
    "top_n_without_group_by",
    "invalid_include_other",
    "invalid_filter_value",
    "too_many_filter_values",
    "unknown_filter_reference",
    "invalid_amount_range",
    "invalid_chart_kind",
    "chart_not_allowed_for_measure",
    "chart_not_allowed_for_shape",
    "too_many_points",
    "too_many_series",
    "too_many_rows",
    "filter_not_allowed_for_measure",
    "report_not_found",
    "report_deleted",
    "report_not_deleted",
    "invalid_dashboard_layout",
    "invalid_dashboard_slot",
    "report_not_allowed_in_slot",
    "duplicate_dashboard_report"
  ],
  "time_grain_days": {
    "day": 1,
    "week": 7,
    "month": 28,
    "quarter": 90,
    "year": 365
  },
  "_comment_time_grain_days": "Shortest length of each step, so max_days / step days is the most points a definition can produce."
}
