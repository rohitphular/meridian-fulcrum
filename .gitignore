# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Dev task files
**/dev-tasks/

# Local server PID file (make app-start / app-stop)
.server.pid

# clasp credentials — never commit OAuth tokens
.clasprc.json

# Local configs, secrets, and temp files — never commit
_do-not-touch/
infrastructure/.env.*

# Python virtual environments
**/.venv/

# PostgreSQL data volume
_volume/

# Python bytecode
**/__pycache__/
**/*.pyc
**/*.pyo

# Consolidated pipeline configs, one per env (per machine; copy config/pipeline.example.json)
data-synchronization/consolidated-pipeline/config/pipeline.*.json
!data-synchronization/consolidated-pipeline/config/pipeline.example.json

# Consolidated pipeline run reports (read by output/index.html)
data-synchronization/consolidated-pipeline/output/data/
